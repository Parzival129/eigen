# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./genai.db
DATABASE_SYNC_URL=sqlite:///./genai.db

# PostgreSQL (for production — install with: pip install -e ".[postgres]")
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genai
# DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/genai

OPENAI_API_KEY=sk-...
MOORCHEH_API_KEY=...
MOORCHEH_NAMESPACE=educational-content
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_FILE_SIZE_MB=100
EMBEDDING_MAX_INPUT_TOKENS=8000
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
